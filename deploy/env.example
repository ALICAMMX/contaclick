# ── Supabase (proyecto de PRUEBAS) ──
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon>
SUPABASE_SERVICE_ROLE_KEY=<service_role>
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<anon>
VITE_SUPABASE_PROJECT_ID=<ref>
# Google directo por Supabase Auth (no Lovable)
VITE_AUTH_PROVIDER=supabase

# ── Sitio ──
PUBLIC_SITE_URL=https://pruebas.contaclick.cloud
SITE_URL=https://pruebas.contaclick.cloud
PORT=3100
HOST=127.0.0.1
NODE_ENV=production

# ── IA (proveedor propio, compatible con OpenAI) ──
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=<llave>
AI_MODEL_FAST=gpt-4.1-mini
AI_MODEL_PRO=gpt-4.1
AI_MODEL_EMBED=text-embedding-3-small

# ── SAT ── (generar con: openssl rand -base64 32)
SAT_EFIRMA_MASTER_KEY=<32 bytes base64>
SAT_EFIRMA_KEY_ID=k1
SAT_PROGRAMACIONES_CRON_SECRET=<aleatorio>

# ── Pagos (opcional en pruebas) ──
MERCADOPAGO_ACCESS_TOKEN=
